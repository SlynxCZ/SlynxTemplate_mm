# vim: set sts=2 ts=8 sw=2 tw=99 et ft=python:
#
# Settings every platform shares -- AMBuild twin of makefiles/cmake/shared.cmake.
# The per-platform ones are in linux.ambuild / windows.ambuild.
import os

# Every compiler, before the platform file adds its own flags.
def ConfigureCxx(cxx, options):
  if options.opt == '1':
    cxx.defines += ['NDEBUG']
  if options.debug == '1':
    cxx.defines += ['DEBUG', '_DEBUG']

# The plugin binary, before SdkHelpers adds the SDK's includes and libraries.
def ConfigureBinary(context, binary, sdk, MMSPlugin):
  cxx = binary.compiler
  mms_core_path = os.path.join(MMSPlugin.mms_root, 'core')

  cxx.cxxincludes += [
    os.path.join(context.currentSourcePath),
    os.path.join(mms_core_path),
    os.path.join(MMSPlugin.mms_root, 'third_party', 'khook', 'include'),
    # NOT os.path.join(mms_core_path, 'sourcehook'): this plugin brings its
    # own private SourceHook (vendor/sourcehook submodule). See the caveat
    # in src/plugin.h and README.md -- the ICvar vtable slot hooked here is
    # hooked by other plugins through metamod's shared engine too.
    # AddPublicIncludes() below covers every header a consumer needs,
    # including the shim that keeps metamod's own ISmmPlugin.h
    # `#include "sourcehook.h"` resolving -- to our copy.
  ]

  MMSPlugin.sourcehook_lib['config'].AddPublicIncludes(binary)

  for other_sdk in MMSPlugin.sdk_manifests:
    cxx.defines += ['SE_{}={}'.format(other_sdk['define'], other_sdk['code'])]

  if sdk['source2']:
    # The same list, in the same order, as CMakeLists.txt's.
    binary.sources += [
      os.path.join(sdk['path'], 'public', 'tier0', 'memoverride.cpp'),
      os.path.join(sdk['path'], 'tier0_perproject', 'bitbuf.cpp'),
      os.path.join(sdk['path'], 'tier0_perproject', 'convar.cpp'),
      os.path.join(sdk['path'], 'tier0_perproject', 'keyvalues3.cpp'),
      os.path.join(sdk['path'], 'entity2', 'entityidentity.cpp'),
      os.path.join(sdk['path'], 'entity2', 'entitykeyvalues.cpp'),
      os.path.join(sdk['path'], 'entity2', 'entitysystem.cpp')
    ]

  # The version the plugin reports: the release tag and the commit.
  sha = os.environ.get("GITHUB_SHA_SHORT", "Local")
  semver = os.environ.get("SEMVER", "Local")
  cxx.defines += [
    f'GITHUB_SHA="{sha}"',
    f'SEMVER="{semver}"',
  ]

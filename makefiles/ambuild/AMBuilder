import os

# Here only one sdk should be available to generate only one executable in the end,
# as multi-sdk loading isn't supported out of the box by metamod, and would require specifying the full path in the vdf
# which in the end would ruin the multi-platform (unix, win etc) loading by metamod as it won't be able to append platform specific extension
# so just fall back to the single binary.
# Multi-sdk solutions should be manually loaded with a custom plugin loader (examples being sourcemod, stripper:source)
for sdk_target in MMSPlugin.sdk_targets:
  sdk = sdk_target.sdk
  cxx = sdk_target.cxx

  binary = MMSPlugin.HL2Library(builder, cxx, MMSPlugin.plugin_name, sdk)

  binary.sources += [
    os.path.join(builder.sourcePath, 'src', 'plugin.cpp'),
  ]

  binary.sources += [
    os.path.join(builder.sourcePath, 'src', 'sdk', 'schemasystem_helper.cpp'),
  ]

  binary.compiler.linkflags += [
    MMSPlugin.sourcehook_lib['binaries_by_arch'][cxx.target.arch],
    MMSPlugin.dynlibutils_lib[cxx.target.arch],
  ]

  binary.compiler.cxxincludes += [
    os.path.join(builder.sourcePath, 'src'),
    os.path.join(builder.sourcePath, 'src', 'protobuf'),
    os.path.join(builder.sourcePath, 'src', 'sdk'),
    os.path.join(builder.sourcePath, 'vendor'),
    os.path.join(builder.sourcePath, 'vendor', 'dynlibutils', 'include'),
    os.path.join(builder.sourcePath, 'vendor', 'dynlibutils', 'include', 'dynlibutils')
  ]

  binary.compiler.defines += [
    'JSON_DIAGNOSTICS=2'
  ]

  # The SDK's protos, relative to s2sdk -- s2sdk_protobufs() in CMakeBuilder.cmake.
  SdkHelpers.addProtobufs(builder, binary, sdk_target, [
    'common/network_connection.proto',
    'common/networkbasetypes.proto',
    'networksystem/networksystem_protomessages.proto',
    'game/shared/cs/cs_gameevents.proto',
    'game/shared/cs/cs_usercmd.proto',
    'game/shared/base_gcmessages.proto',
    'game/shared/econ/econ_gcmessages.proto',
    'common/engine_gcmessages.proto',
    'gcsdk/gcsdk_gcmessages.proto',
    'gcsdk/gcsystemmsgs.proto',
    'game/shared/cstrike15/cstrike15_gcmessages.proto',
    'game/shared/cstrike15/cstrike15_usermessages.proto',
    'common/source2_steam_stats.proto',
    'common/netmessages.proto',
    'gcsdk/steammessages.proto',
    'game/shared/usercmd.proto',
    'game/shared/usermessages.proto',
    'game/shared/gameevents.proto',
    'game/shared/clientmessages.proto',
    'game/shared/te.proto',
    'common/valveextensions.proto',
  ])
  # The protos import each other by name, also from folders s2sdk-manifests'
  # protoc doesn't search (s2sdk_protobufs() adds every listed proto's folder).
  binary.custom[-1].protoc.includes += [
    os.path.join(sdk['path'], 'gcsdk'),
    os.path.join(sdk['path'], 'game', 'shared', 'cstrike15'),
  ]

  nodes = builder.Add(binary)
  MMSPlugin.binaries += [nodes]

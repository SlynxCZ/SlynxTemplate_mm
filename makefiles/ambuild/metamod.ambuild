# vim: set sts=2 ts=8 sw=2 tw=99 et ft=python:
#
# The plugin's metamod .vdf -- AMBuild twin of makefiles/cmake/metamod.cmake.
#
# Both build systems fill in the one template, makefiles/metamod/<name>.vdf.in,
# the way CMake's configure_file() does, so the .vdf in an AMBuild package is
# byte-identical to the one CMake writes to configs/addons/metamod/.
import os
import re

# Keep in step with makefiles/cmake/metamod.cmake.
VDF_TEMPLATE = 'slynx_template.vdf.in'

# The ${VAR} and @VAR@ forms configure_file() replaces, with its name charset.
_VARIABLE = re.compile(r'\$\{([A-Za-z0-9/_.+-]+)\}|@([A-Za-z0-9/_.+-]+)@')

def ConfigureFile(text, variables):
  # configure_file() without options: every ${VAR} / @VAR@ is replaced, unset
  # ones by nothing, and each line is written with a plain '\n' -- a CR before
  # it is dropped and the last line gets one even when the template has none.
  lines = text.split('\n')
  if lines[-1] == '':
    lines.pop()
  out = ''
  for line in lines:
    if line.endswith('\r'):
      line = line[:-1]
    line = _VARIABLE.sub(lambda m: variables.get(m.group(1) or m.group(2), ''), line)
    out += line + '\n'
  return out

# The variables metamod.cmake sets for the template.
def TemplateVariables(cxx):
  return {
    'PROJECT_VDF_PLATFORM': 'win64' if cxx.target.platform == 'windows' else 'linuxsteamrt64',
  }

# Writes <metamod_path>/<name>.vdf; called from package.ambuild.
def GenerateVDF(builder, metamod_path, cxx):
  template = os.path.join(builder.sourcePath, 'makefiles', 'metamod', VDF_TEMPLATE)
  # Editing the template re-runs the configure step, as it does for CMake.
  builder.AddConfigureFile(template)

  with open(template, 'r', encoding='utf-8', newline='') as fp:
    text = fp.read()

  vdf_name = os.path.splitext(VDF_TEMPLATE)[0]
  return builder.AddOutputFile(
    os.path.join(metamod_path, vdf_name),
    ConfigureFile(text, TemplateVariables(cxx)).encode('utf-8')
  )
